{
  "id": "root",
  "type": "column",
  "font": "D2Coding",
  "ui_font": "Pretendard GOV",
  "background": "canvas",
  "terminal_padding": [
    12,
    10
  ],
  "padding": 8,
  "gap": 8,
  "children": [
    {
      "id": "office-top",
      "type": "row",
      "size": {
        "weight": 3
      },
      "gap": 8,
      "children": [
        {
          "id": "office-floor",
          "type": "block",
          "size": {
            "weight": 1
          },
          "min": 240,
          "radius": 10,
          "border": {
            "width": 1,
            "color": "border"
          },
          "content": {
            "mod": "office",
            "props": {
              "role": "floor"
            }
          }
        },
        {
          "id": "office-term",
          "type": "column",
          "size": {
            "weight": 2
          },
          "children": [
            {
              "id": "office-termbar",
              "type": "block",
              "size": {
                "px": 32
              },
              "content": {
                "mod": "office",
                "props": {
                  "role": "termbar"
                }
              }
            },
            {
              "id": "office-tab",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "gap": 8,
                  "radius": 10,
                  "background": "background",
                  "lone": true,
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "focus": {
                    "width": 1,
                    "color": "accent"
                  }
                }
              }
            }
          ]
        }
      ]
    },
    {
      "id": "office-bottom",
      "type": "row",
      "size": {
        "weight": 2
      },
      "gap": 8,
      "children": [
        {
          "id": "office-apps",
          "type": "block",
          "size": {
            "weight": 1
          },
          "min": 420,
          "radius": 10,
          "border": {
            "width": 1,
            "color": "border"
          },
          "background": "chrome",
          "content": {
            "mod": "office-apps"
          }
        },
        {
          "id": "office-side",
          "type": "stack",
          "size": {
            "px": 300
          },
          "min": 240,
          "children": [
            {
              "id": "office-usage",
              "type": "block",
              "content": {
                "mod": "office-usage"
              }
            },
            {
              "id": "office-resources",
              "type": "block",
              "content": {
                "mod": "office-resources"
              }
            }
          ],
          "active": "office-usage",
          "header": {
            "content": {
              "mod": "office-resources",
              "props": {
                "role": "tabs"
              }
            },
            "height": 36
          },
          "radius": 10,
          "border": {
            "width": 1,
            "color": "border"
          },
          "background": "chrome"
        }
      ]
    }
  ]
}
